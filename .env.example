# Neon 연결 문자열 — 앱/함수용은 반드시 pooler 엔드포인트를 쓴다.
# 서버리스는 스케일아웃할 때마다 커넥션을 새로 열기 때문에 직접 연결은 금방 고갈된다.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/steampulse?sslmode=require

# 마이그레이션 전용(직접 연결). npm run db:migrate 가 이 값을 쓴다.
DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/steampulse?sslmode=require

# /api/cron 인증용. openssl rand -hex 32 로 만든다.
# 이게 없거나 틀리면 크론 엔드포인트는 401 을 낸다(설정 누락 시 열리지 않는다).
CRON_SECRET=

# GitHub Actions 가 호출할 배포 주소 (스케줄러가 워커를 부를 때 사용)
SITE_URL=https://steampulse.example.com

# 이메일 알림 (Resend). **두 값이 다 있어야** 기능이 켜진다 —
# 하나만 있으면 구독 폼이 그려지지 않고 /api/alerts 는 404 이며 발송 잡은 그냥 끝난다.
# 폼은 보이는데 메일은 안 오는 '반쯤 켜진' 상태를 만들지 않기 위해서다.
RESEND_API_KEY=
# 도메인 인증이 끝난 발신 주소. "Steam Pulse <alerts@example.com>" 형태를 그대로 받는다.
MAIL_FROM=

# 저장소 예산(MB). 없으면 512 — Neon 무료 0.5GB 다.
# 요금제를 올리면(예: 3GB → 3072) 보관정책·경보·/status 가 함께 따라간다. 코드는 안 고친다.
DB_SIZE_BUDGET_MB=512
# 평상시 보관 기간. 예산의 70% 를 넘으면 prune 이 알아서 좁히고, 여유가 생기면 이 값으로 돌아온다.
# 원시는 3일 밑으로 내려가지 않는다 — 일 롤업이 이틀 치 원시를 다시 읽기 때문이다.
RETENTION_SNAPSHOT_DAYS=7
RETENTION_HOURLY_DAYS=90

# 계정(회원 가입·로그인)에는 새 환경변수가 필요 없다.
# DATABASE_URL 만 있으면 켜지고, 비밀번호 해시(scrypt)와 세션은 Node 표준 crypto 로 만든다.
# 다만 db/schema.sql 의 users / user_sessions / user_watchlist 테이블과
# db/functions.sql 의 prune_sessions() 가 DB 에 적용돼 있어야 한다.
# 적용 여부는 /status 가 아니라 아래로 확인한다 — 테이블 14개 · 함수 6개.
#   node --env-file=.env -e "import('./lib/db.mjs').then(async({getSql})=>{const s=getSql();console.log((await s\`SELECT table_name FROM information_schema.tables WHERE table_schema='public'\`).length)})"
