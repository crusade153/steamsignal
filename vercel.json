{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/game/:slug/reviews",
      "destination": "/api/page?route=gameReviews&slug=:slug"
    },
    {
      "source": "/game/:slug",
      "destination": "/api/page?route=game&slug=:slug"
    },
    {
      "source": "/rising",
      "destination": "/api/page?route=rising"
    },
    {
      "source": "/deals/all-time-low",
      "destination": "/api/page?route=dealsLow"
    },
    {
      "source": "/deals",
      "destination": "/api/page?route=deals"
    },
    {
      "source": "/charts/weekly",
      "destination": "/api/page?route=weekly"
    },
    {
      "source": "/charts/monthly",
      "destination": "/api/page?route=monthly"
    },
    {
      "source": "/genre",
      "destination": "/api/page?route=genres"
    },
    {
      "source": "/platform/:key",
      "destination": "/api/page?route=platform&key=:key"
    },
    {
      "source": "/platform",
      "destination": "/api/page?route=platforms"
    },
    {
      "source": "/genre/:genre/free",
      "destination": "/api/page?route=genreFree&genre=:genre"
    },
    {
      "source": "/genre/:genre/discounted",
      "destination": "/api/page?route=genreDiscounted&genre=:genre"
    },
    {
      "source": "/genre/:genre",
      "destination": "/api/page?route=genre&genre=:genre"
    },
    {
      "source": "/releases",
      "destination": "/api/page?route=releases"
    },
    {
      "source": "/releases/:year",
      "destination": "/api/page?route=release&year=:year"
    },
    {
      "source": "/status",
      "destination": "/api/page?route=status"
    },
    {
      "source": "/watchlist",
      "destination": "/api/page?route=watchlist"
    },
    {
      "source": "/account/login",
      "destination": "/api/page?route=accountLogin"
    },
    {
      "source": "/account/signup",
      "destination": "/api/page?route=accountSignup"
    },
    {
      "source": "/account",
      "destination": "/api/page?route=account"
    },
    {
      "source": "/alerts",
      "destination": "/api/page?route=alerts"
    },
    {
      "source": "/alerts/confirm",
      "destination": "/api/page?route=alertsConfirm"
    },
    {
      "source": "/alerts/unsubscribe",
      "destination": "/api/page?route=alertsUnsubscribe"
    },
    {
      "source": "/privacy",
      "destination": "/api/page?route=privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/page?route=terms"
    },
    {
      "source": "/contact",
      "destination": "/api/page?route=contact"
    },
    {
      "source": "/ads.txt",
      "destination": "/api/page?route=ads"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
