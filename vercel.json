{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/game/:slug",
      "destination": "/api/page?route=game&slug=:slug"
    },
    {
      "source": "/rising",
      "destination": "/api/page?route=rising"
    },
    {
      "source": "/deals",
      "destination": "/api/page?route=deals"
    },
    {
      "source": "/charts/weekly",
      "destination": "/api/page?route=weekly"
    },
    {
      "source": "/genre",
      "destination": "/api/page?route=genres"
    },
    {
      "source": "/genre/:genre",
      "destination": "/api/page?route=genre&genre=:genre"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
